{
  "bindings": [
    {
      "name": "Timer",
      "type": "timerTrigger",
      "direction": "in",
      "schedule": "0 0 * * * *"
    },
    {
      "type": "cosmosDB",
      "direction": "out",
      "name": "outputDocument",
      "databaseName": "cosmos-spotifyexport",
      "containerName": "RecentlyPlayed",
      "createIfNotExists": false,
      "connection": "COSMOS_CONNECTION_STRING",
      "partitionKey": "id"
    }
  ]
}
